# Copy to .env and fill in only what you want to use. Everything here is optional:
# with no keys at all Melodle still plays using global and genre charts.

PORT=8787
# Set HOST=0.0.0.0 to let other devices on your Wi-Fi (a phone) reach the server.
HOST=
# Where the browser reaches the app, used to build the OAuth redirect URIs.
# Leave it blank unless you deploy: it defaults to localhost:5173 in development
# and to localhost:<PORT> for `npm start`.
PUBLIC_ORIGIN=

# Set this if the server is reachable beyond your own Wi-Fi. When it has a value,
# making an account needs it, so strangers who find the address cannot sign up.
INVITE_CODE=

# Accounts that may set this server's API keys from the page, comma separated.
# Empty means whoever made the first account. On a deployed server that is the
# only way to set keys from the page; they are then kept, sealed, in the database.
ADMIN_USERS=

# Accounts that hear songs from their real opening, cut from the song's YouTube
# album upload, instead of the mid-song preview. Comma separated. Empty means
# every signed-in account; guests never do.
SONG_START_USERS=

# Signs the session cookie that holds provider tokens. Any long random string.
SESSION_SECRET=

# Last.fm - https://www.last.fm/api/account/create (API key only, no secret needed
# because Melodle reads public scrobbles for a username you type in).
LASTFM_API_KEY=

# Spotify - https://developer.spotify.com/dashboard
# Add <PUBLIC_ORIGIN>/api/auth/spotify/callback as a Redirect URI.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Music - Google Cloud console, OAuth client (Web application) with the
# YouTube Data API v3 enabled. Redirect URI: <PUBLIC_ORIGIN>/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file holding accounts, connections, ratings and round history.
DATA_FILE=melodle.db
